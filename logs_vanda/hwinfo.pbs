#!/bin/bash
#PBS -N hwinfo
#PBS -P personal-e1621744
#PBS -l select=1:ncpus=1:mem=4gb:host=cn-089
#PBS -l walltime=00:05:00
#PBS -j oe
cd $PBS_O_WORKDIR
hostname
lscpu
numactl -H 2>/dev/null | head -20
free -g
for n in /sys/class/net/*; do echo "$n $(cat $n/speed 2>/dev/null) Mb/s"; done
ibv_devinfo 2>/dev/null | head -20
