#!/bin/bash
#PBS -N test_256
#PBS -P personal-e1621744
#PBS -l select=4:ncpus=64:mpiprocs=64:ompthreads=1:mem=32gb
#PBS -l walltime=00:10:00
#PBS -j oe
cd $PBS_O_WORKDIR
module load gcc/13.1.0 openmpi4/gcc/4.1.8
echo "=== nodes"; sort -u $PBS_NODEFILE
echo "=== network"; ls /sys/class/infiniband 2>/dev/null; ip -br link | grep -v '^lo'
echo "=== MPI components"; ompi_info 2>/dev/null | grep -E 'MCA (btl|pml):'
echo "=== 256 rank run"
mpirun -hostfile $PBS_NODEFILE --mca mca_base_component_show_load_errors 0 -x LD_LIBRARY_PATH \
  --mca btl_base_verbose 10 -np 256 bin/poisson_mpi --dim 2 --n 128 --solver cg --tol 1e-8 --iters 100000 > test_256.out 2> test_256.err
echo "exit code $?"
grep -E '^(impl|iters)=' test_256.out
echo "=== transports"; grep -Eo 'btl: *[a-z]+|selected.*(tcp|openib|vader|ucx)' test_256.err | sort | uniq -c | head -20
tail -n 5 test_256.err
