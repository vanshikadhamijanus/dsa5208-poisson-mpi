mpirun --prefix /cm/shared/apps/openmpi4/gcc/4.1.8 -hostfile $PBS_NODEFILE --map-by core --bind-to core --mca mca_base_component_show_load_errors 0 -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x OMP_PROC_BIND -x OMP_PLACES -np 4 bin/poisson_mpi --dim 3 --local-n 48   --solver cg --iters 300 --csv results/cluster/weak.csv --tag cg3d
