mpirun --prefix /cm/shared/apps/openmpi4/gcc/4.1.8 -hostfile $PBS_NODEFILE --map-by core --bind-to core --mca mca_base_component_show_load_errors 0 -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x OMP_PROC_BIND -x OMP_PLACES -np 2 bin/poisson_mpi --data data/india_2025.grid --dim 3 --holdout 0.1 --holdout-block 16 --tweight 1 --solver jacobi --iters 200 --csv results/cluster/gapfill.csv --tag sst3d_jac
